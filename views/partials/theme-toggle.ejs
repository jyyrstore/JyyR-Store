<button
  class="icon-button theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Theme Mode (Dark)"
  title="Theme Mode (Dark)"
  aria-pressed="false"
>
  <%- icon('sun-16','theme-toggle-icon theme-toggle-sun') %>
  <%- icon('moon-sleep','theme-toggle-icon theme-toggle-moon') %>
  <span class="theme-toggle-label" data-theme-label>Theme Mode (Dark)</span>
</button>
