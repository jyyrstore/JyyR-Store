<section class="page-shell">
  <div class="page-header">
    <div>

      <h1 class="page-title-with-icon"><%- icon('shop-twotone','icon page-title-icon') %><span>Katalog produk</span></h1>
      <p><%= total %> produk tersedia. Gunakan filter untuk mempersempit pilihan.</p>
    </div>
    <% if (currentUser) { %>
      <a class="button button-secondary cart-button" href="/cart" data-cart-link>
        <%- icon('cart') %>
        <span>Keranjang</span>
        <span class="cart-count" data-cart-badge hidden></span>
      </a>
    <% } %>
  </div>

  <%
    const activeFilters = [
      String(req.query.search||'').trim(),
      String(req.query.category||'').trim(),
      String(req.query.minPrice||'').trim(),
      String(req.query.maxPrice||'').trim(),
      String(req.query.sort||'').trim() && req.query.sort !== 'position' ? req.query.sort : ''
    ].filter(Boolean);
    const activeFilterCount = activeFilters.length;
  %>

  <form class="filter-bar catalog-filter-bar" method="get" action="/store">
    <label class="field-inline filter-search">
      <input
        name="search"
        value="<%= req.query.search||'' %>"
        type="search"
        placeholder="Cari produk..."
        aria-label="Cari produk"
      >
    </label>

    <input
      class="filter-min"
      name="minPrice"
      value="<%= req.query.minPrice||'' %>"
      type="number"
      min="0"
      placeholder="Harga min"
      aria-label="Harga minimum"
    >

    <div class="jyyr-select filter-category" data-jyyr-select>
  <input
    type="hidden"
    class="filter-category-value"
    name="category"
    value="<%= req.query.category||'' %>"
    data-jyyr-select-value
  >
  <button class="jyyr-select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" data-jyyr-select-trigger>
    <span data-jyyr-select-label>Semua kategori</span>
    <span class="jyyr-select-chevron" aria-hidden="true"></span>
  </button>
  <div class="jyyr-select-menu" role="listbox" data-jyyr-select-menu>
      <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="" data-label="Semua kategori">Semua kategori</button>
      <% categories.forEach(c=>{
        const categoryParent=categories.find(
          parent=>String(parent.id)===String(c.parent_id)
        );
        const categoryLabel=categoryParent
          ? categoryParent.name+' → '+c.name
          : c.name;
      %>
        <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="<%= c.slug %>" data-label="<%= categoryLabel %>" data-icon-name="<%= c.icon_key||'category-management' %>">
          <span class="jyyr-select-option-content">
            <% if(categoryParent){ %>
              <span class="category-name-with-icon"><%- icon(categoryParent.icon_key||'category-management','icon category-inline-icon') %><span><%= categoryParent.name %></span></span>
              <span aria-hidden="true">→</span>
            <% } %>
            <span class="category-name-with-icon"><%- icon(c.icon_key||'category-management','icon category-inline-icon') %><span><%= c.name %></span></span>
          </span>
        </button>
      <% }) %>
  </div>
</div>

    <input
      class="filter-max"
      name="maxPrice"
      value="<%= req.query.maxPrice||'' %>"
      type="number"
      min="0"
      placeholder="Harga max"
      aria-label="Harga maksimum"
    >

    <div class="jyyr-select filter-sort" data-jyyr-select>
  <input
    type="hidden"
    class="filter-sort-value"
    name="sort"
    value="<%= req.query.sort||'position' %>"
    data-jyyr-select-value
  >
  <button class="jyyr-select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" data-jyyr-select-trigger>
    <span data-jyyr-select-label>Urutan Produk</span>
    <span class="jyyr-select-chevron" aria-hidden="true"></span>
  </button>
  <div class="jyyr-select-menu" role="listbox" data-jyyr-select-menu>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="position" data-label="Urutan Produk">Urutan Produk</button>
<button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="newest" data-label="Terbaru">Terbaru</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="popular" data-label="Populer">Populer</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="price_asc" data-label="Harga rendah">Harga rendah</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="price_desc" data-label="Harga tinggi">Harga tinggi</button>
  </div>
</div>

    <button class="button button-primary button-small filter-submit" type="submit">
      Terapkan Filter
    </button>
  </form>

  <div class="filter-status" aria-live="polite">
    <span>
      <%= activeFilterCount ? `${activeFilterCount} filter aktif` : 'Menampilkan semua produk' %>
    </span>
    <% if(activeFilterCount){ %>
      <a href="/store">Hapus filter</a>
    <% } %>
  </div>

  <% if(items.length){ %>
    <div class="product-grid"><% items.forEach(product=>{ %><%- include('../partials/product-card',{product}) %><% }) %></div>
    <%- include('../partials/pagination',{
  pagination:storePagination,
  param:'page',
  query:{
    search:req.query.search,
    category:req.query.category,
    minPrice:req.query.minPrice,
    maxPrice:req.query.maxPrice,
    sort:req.query.sort
  },
  label:'Pagination produk store'
}) %>
  <% } else if(!(providerCatalog||[]).length){ %>
    <%- include('../partials/empty',{title:'Belum ada produk tersedia',description:'Coba kata kunci atau filter lain.',actionUrl:'/store',actionLabel:'Reset Filter'}) %>
  <% } %>

  <% if((providerCatalog||[]).length){ %>
    <section class="store-provider-catalog" aria-labelledby="provider-catalog-title">
      <div class="page-header">
        <div>
          <h2 id="provider-catalog-title" class="page-title-with-icon">
            <%- icon('shop-twotone','icon page-title-icon') %>
            <span>Katalog Digital</span>
          </h2>
          <p>Produk premium dan game dari katalog provider.</p>
          <p class="muted">Informasi katalog saja. Pemesanan provider belum terhubung.</p>
        </div>
      </div>

      <% providerCatalog.forEach(root=>{ %>
        <section class="store-provider-root section" aria-label="Kategori <%= root.name %>">
          <% root.subcategories.forEach(category=>{ %>
            <section class="store-provider-category">
              <div class="section-header home-subcategory-header">
                <span class="home-parent-category-name">
                  <span class="category-name-with-icon">
                    <%- icon(root.icon_key||'premium-app','icon category-inline-icon') %>
                    <span><%= root.name %></span>
                  </span>
                </span>
                <div class="home-subcategory-heading">
                  <h2>
                    <span class="category-name-with-icon">
                      <%- icon(category.icon_key||root.icon_key||'premium-app','icon category-inline-icon') %>
                      <span><%= category.name %></span>
                    </span>
                  </h2>
                  <span class="home-subcategory-count" aria-label="<%= category.products.length %> produk"><%= category.products.length %></span>
                </div>
                <span class="home-subcategory-rule" aria-hidden="true"></span>
              </div>

              <div class="product-grid">
                <% category.products.forEach(product=>{ %>
                  <a
                    class="product-card provider-product-card"
                    href="/store/dwigital/<%= product.provider_type %>/<%= encodeURIComponent(product.provider_product_id) %>"
                    aria-label="Lihat detail <%= product.display_name %>"
                  >
                    <div class="product-thumb-wrap">
                      <% if(product.cover_url){ %>
                        <img
                          class="product-thumb"
                          src="<%= product.cover_url %>"
                          alt="Cover <%= product.display_name %>"
                          width="600"
                          height="600"
                          loading="lazy"
                          decoding="async"
                        >
                      <% } else { %>
                        <div class="image-fallback">
                          <%- icon('image') %>
                          <span>Gambar tidak tersedia</span>
                        </div>
                      <% } %>
                    </div>

                    <div class="product-body">
                      <div class="product-action-row">
                        <span class="product-title"><%= product.display_name %></span>
                      </div>

                    </div>
                  </a>
                <% }) %>
              </div>
            </section>
          <% }) %>
        </section>
      <% }) %>
    </section>
  <% } %>

</section>
