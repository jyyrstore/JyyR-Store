<section class="page-shell">
  <div class="page-header">
    <a class="button button-secondary" href="/store">
      <%- icon('arrow-left') %>
      Kembali ke Katalog Digital
    </a>
  </div>

  <div class="product-detail dwigital-product-detail">
    <div class="detail-media">
      <button
        type="button"
        class="icon-button detail-share-button"
        data-product-share
        data-share-title="<%= providerProduct.display_name %>"
        aria-label="Bagikan produk"
        title="Bagikan produk"
      >
        <%- icon('share') %>
      </button>

      <%
        const providerProductCoverUrl=String(
          providerProduct.cover_url||''
        ).trim();
        const providerVariantCount=Array.isArray(providerProduct.variants)
          ? providerProduct.variants.length
          : 0;
      %>

      <div class="detail-image-frame">
        <img
          <% if(providerProductCoverUrl){ %>
            src="<%= providerProductCoverUrl %>"
          <% } %>
          alt="Cover <%= providerProduct.display_name %>"
          class="detail-image"
          loading="eager"
          decoding="async"
          data-image-fallback
          data-product-variant-selected-icon
          data-product-variant-default-src="<%= providerProductCoverUrl %>"
          <% if(!providerProductCoverUrl){ %>hidden<% } %>
        >

        <div
          class="detail-image-fallback image-fallback"
          <%= providerProductCoverUrl ? 'hidden' : '' %>
        >
          <%- icon('image') %>
          <span>Gambar tidak tersedia</span>
        </div>

        <button
          type="button"
          class="detail-image-open"
          data-product-image-open
          aria-label="Lihat gambar penuh <%= providerProduct.display_name %>"
          title="Lihat gambar penuh"
          <% if(!providerProductCoverUrl){ %>hidden<% } %>
        ></button>
      </div>
    </div>

    <div class="detail-product-stats" aria-label="Informasi produk">
      <div class="detail-product-stat">
        <span class="detail-product-stat-value">
          <%- icon('category-management','icon category-inline-icon') %>
          <span>
            <%= providerProduct.category_parent_name||'Katalog Digital' %>
            <% if(providerProduct.category_name){ %>
              · <%= providerProduct.category_name %>
            <% } %>
          </span>
        </span>
      </div>

      <div class="detail-product-stat">
        <span class="detail-product-stat-value">
          <%- icon('package') %>
          <span><%= providerVariantCount %> Varian</span>
        </span>
      </div>

      <div class="detail-product-stat">
        <span class="detail-product-stat-value">
          <strong><%= Number(providerProduct.view_count||0).toLocaleString('id-ID') %></strong>
          <span>Dilihat</span>
        </span>
      </div>

      <div class="detail-product-stat">
        <span class="detail-product-stat-value">
          <strong><%= Number(providerProduct.purchase_count||0).toLocaleString('id-ID') %></strong>
          <span>Pembelian</span>
        </span>
      </div>
    </div>

    <div class="detail-copy">
      <div class="detail-title-row">
        <h1><%= providerProduct.display_name %></h1>
      </div>

      <h2 class="detail-description-heading">Informasi Produk</h2>
      <p class="detail-description">
        Pilih varian yang sesuai untuk melihat harga jual dan melanjutkan pembelian.
      </p>
    </div>

    <form
      id="dwigital-purchase-form"
      class="detail-variant-card dwigital-purchase-form"
      data-dwigital-purchase-form
      data-type="<%= providerProduct.provider_type %>"
      data-product-id="<%= providerProduct.provider_product_id %>"
      data-authenticated="<%= isAuthenticated ? '1' : '0' %>"
      data-wallet-balance="<%= Number(walletBalance||0) %>"
    >
      <h2 class="detail-variant-title" id="dwigital-variant-title">
        Pilihan Varian &amp; Harga
      </h2>

      <div
        class="detail-variant-options"
        data-product-variant-picker
        role="group"
        aria-labelledby="dwigital-variant-title"
      >
        <% providerProduct.variants.forEach(variant=>{
          const fields=Array.isArray(variant.fields)?variant.fields:[];
          const targetField=fields.find(field=>field?.name==='target');
          const zoneField=fields.find(field=>field?.name==='target_zone');
          const unsupportedField=fields.some(
            field=>
              field?.required===true &&
              !['target','target_zone'].includes(String(field.name||''))
          );
          const hasExtraField=Boolean(String(variant.extra_field||'').trim());
          const priceUnit=String(variant.price_unit||'per_order').toLowerCase();
          const canPurchase=
            priceUnit==='per_order'&&
            !hasExtraField&&
            !unsupportedField;
          const zoneRequired=
            ['true','1','yes'].includes(
              String(variant.zone_required||'').toLowerCase()
            )||
            zoneField?.required===true;
          const zoneVisible=zoneRequired||Boolean(zoneField);
          const targetLabel=
            targetField?.label||
            variant.target_label||
            'Target';
          const zoneLabel=
            zoneField?.label||
            variant.zone_label||
            'Zone';
        %>
          <button
            type="button"
            class="product-variant-card-option"
            data-dwigital-variant
            data-purchasable="<%= canPurchase ? '1' : '0' %>"
            data-variant-id="<%= variant.variant_id %>"
            data-price="<%= Number(variant.retail_price||0) %>"
            data-target-label="<%= targetLabel %>"
            data-zone-label="<%= zoneLabel %>"
            data-zone-required="<%= zoneRequired ? '1' : '0' %>"
            data-zone-visible="<%= zoneVisible ? '1' : '0' %>"
            aria-pressed="false"
            <%= canPurchase ? '' : 'disabled' %>
          >
            <span class="product-variant-option-icon" aria-hidden="true">
              <% if(variant.icon_url){ %>
                <img
                  src="<%= variant.icon_url %>"
                  alt=""
                  width="38"
                  height="38"
                  loading="lazy"
                  decoding="async"
                >
              <% } else { %>
                <%- icon('package') %>
              <% } %>
            </span>

            <span class="product-variant-card-details">
              <strong><%= variant.display_name||variant.source_name||'Varian' %></strong>
              <span class="product-variant-card-price">
                <%= formatIDR(variant.retail_price) %>
              </span>
              <% if(!canPurchase){ %>
                <small class="muted">Belum mendukung pembelian otomatis</small>
              <% } %>
            </span>
          </button>
        <% }) %>
      </div>

      <div class="stack-form">
        <label class="field" for="dwigital-target">
          <span data-dwigital-target-label>Target</span>
          <input
            id="dwigital-target"
            type="text"
            maxlength="254"
            autocomplete="off"
            required
            disabled
            placeholder="Pilih varian terlebih dahulu"
            data-dwigital-target
          >
        </label>

        <label
          class="field"
          for="dwigital-target-zone"
          data-dwigital-zone-wrapper
          hidden
        >
          <span data-dwigital-zone-label>Zone</span>
          <input
            id="dwigital-target-zone"
            type="text"
            maxlength="64"
            autocomplete="off"
            disabled
            data-dwigital-zone
          >
        </label>
      </div>

      <fieldset class="payment-group">
        <legend>Metode pembayaran</legend>
        <div class="payment-options">
          <label class="payment-option">
            <input
              type="radio"
              name="dwigitalPaymentMethod"
              value="BALANCE"
              data-dwigital-balance
              <%= isAuthenticated && Number(walletBalance||0)>0 ? '' : 'disabled' %>
            >
            <span class="payment-option__copy payment-option__copy--wallet">
              <strong>Saldo Wallet JYYR</strong>
              <small data-dwigital-wallet-balance>
                Saldo tersedia <%= formatIDR(walletBalance||0) %>
              </small>
            </span>
          </label>

          <label class="payment-option is-selected">
            <input
              type="radio"
              name="dwigitalPaymentMethod"
              value="GATEWAY"
              data-dwigital-gateway
              checked
            >
            <span class="payment-option__copy payment-option__copy--qris">
              <%- icon('qris', 'icon payment-option-qris', 'Gateway / QRIS') %>
              <strong>Gateway / QRIS</strong>
              <small>Pembayaran melalui penyedia pembayaran</small>
            </span>
          </label>
        </div>
      </fieldset>

      <div class="summary-row total">
        <span>Total pembayaran</span>
        <strong data-dwigital-total>—</strong>
      </div>

      <p
        class="muted small"
        data-dwigital-error
        role="status"
        aria-live="polite"
        hidden
      ></p>

      <details
        class="product-purchase-sheet"
        data-product-purchase-sheet
        open
      >
        <summary
          class="product-purchase-sheet-handle"
          data-product-purchase-sheet-handle
          aria-label="Tutup panel aksi pembelian"
          aria-controls="dwigital-purchase-sheet-actions"
          aria-expanded="true"
        >
          <span
            class="product-purchase-sheet-handle-bar"
            aria-hidden="true"
          ></span>
        </summary>

        <div
          class="product-purchase-sheet-actions"
          id="dwigital-purchase-sheet-actions"
          aria-label="Aksi pembelian Dwigital"
        >
          <% if(isAuthenticated){ %>
            <button
              class="button button-primary button-block"
              type="submit"
              data-dwigital-submit
              disabled
            >
              <%- icon('shopping-bag') %>
              <span data-dwigital-submit-label>Beli Sekarang</span>
            </button>
          <% } else { %>
            <a class="button button-primary button-block" href="/auth/login">
              Masuk untuk membeli
            </a>
          <% } %>
        </div>
      </details>

      <p class="muted small">
        Harga dan ketersediaan akan diverifikasi ulang ke supplier sebelum pesanan dibuat.
      </p>
    </form>

    <script nonce="<%= cspNonce %>">
    (()=>{
      const form=document.querySelector('[data-dwigital-purchase-form]');
      if(!form)return;

      const options=Array.from(
        form.querySelectorAll('[data-dwigital-variant]')
      );
      const target=form.querySelector('[data-dwigital-target]');
      const zone=form.querySelector('[data-dwigital-zone]');
      const zoneWrapper=form.querySelector('[data-dwigital-zone-wrapper]');
      const targetLabel=form.querySelector('[data-dwigital-target-label]');
      const zoneLabel=form.querySelector('[data-dwigital-zone-label]');
      const walletChoice=form.querySelector('[data-dwigital-balance]');
      const gatewayChoice=form.querySelector('[data-dwigital-gateway]');
      const total=form.querySelector('[data-dwigital-total]');
      const errorBox=form.querySelector('[data-dwigital-error]');
      const submit=form.querySelector('[data-dwigital-submit]');
      const submitLabel=form.querySelector('[data-dwigital-submit-label]');
      const authenticated=form.dataset.authenticated==='1';
      const walletBalance=Number(form.dataset.walletBalance||0);

      if(!authenticated||!submit)return;

      let selected=null;
      let selectedPrice=0;
      let submitting=false;

      const idempotencyKey=
        window.crypto&&typeof window.crypto.randomUUID==='function'
          ? window.crypto.randomUUID()
          : `dwigital-${Date.now()}-${Math.random().toString(36).slice(2)}`;

      const money=value=>new Intl.NumberFormat('id-ID',{
        style:'currency',
        currency:'IDR',
        maximumFractionDigits:0
      }).format(value);

      const showError=message=>{
        errorBox.textContent=String(message||'Pembelian tidak dapat diproses.');
        errorBox.hidden=false;
      };

      const syncSubmit=()=>{
        submit.disabled=
          submitting||
          !selected||
          !target.value.trim()||
          (zone.required&&!zone.value.trim())||
          !authenticated;

        if(!submitting){
          submitLabel.textContent=selected
            ? `Beli Sekarang · ${money(selectedPrice)}`
            : 'Beli Sekarang';
        }
      };

      const selectVariant=option=>{
        if(!option||option.dataset.purchasable!=='1')return;

        selected=option;
        selectedPrice=Number(option.dataset.price||0);

        for(const item of options){
          const active=item===option;
          item.classList.toggle('active',active);
          item.setAttribute('aria-pressed',active?'true':'false');
        }

        target.disabled=false;
        target.value='';
        target.required=true;
        targetLabel.textContent=option.dataset.targetLabel||'Target';
        target.placeholder=`Masukkan ${targetLabel.textContent.toLowerCase()}`;

        const zoneVisible=option.dataset.zoneVisible==='1';
        zoneWrapper.hidden=!zoneVisible;
        zone.disabled=!zoneVisible;
        zone.required=option.dataset.zoneRequired==='1';
        zone.value='';
        zoneLabel.textContent=option.dataset.zoneLabel||'Zone';

        const balanceAvailable=walletBalance>=selectedPrice;
        walletChoice.disabled=!balanceAvailable;

        if(walletChoice.disabled&&walletChoice.checked){
          gatewayChoice.checked=true;
        }else if(
          !gatewayChoice.checked&&
          !walletChoice.checked
        ){
          gatewayChoice.checked=true;
        }

        total.textContent=money(selectedPrice);
        errorBox.hidden=true;
        syncSubmit();
      };

      options.forEach(option=>{
        option.addEventListener('click',()=>selectVariant(option));
      });

      target.addEventListener('input',syncSubmit);
      zone.addEventListener('input',syncSubmit);
      walletChoice.addEventListener('change',syncSubmit);
      gatewayChoice.addEventListener('change',syncSubmit);

      const firstAvailable=options.find(
        option=>option.dataset.purchasable==='1'
      );

      if(firstAvailable){
        selectVariant(firstAvailable);

        if(walletBalance>=selectedPrice&&!walletChoice.disabled){
          walletChoice.checked=true;
        }
        syncSubmit();
      }else{
        showError('Belum ada varian yang mendukung pembelian melalui halaman ini.');
      }

      form.addEventListener('submit',async event=>{
        event.preventDefault();

        if(submitting||!selected)return;

        if(!target.reportValidity())return;
        if(!zone.disabled&&!zone.reportValidity())return;

        const paymentMethod=
          form.querySelector('input[name="dwigitalPaymentMethod"]:checked')
            ?.value||'GATEWAY';

        if(paymentMethod==='BALANCE'&&walletBalance<selectedPrice){
          showError('Saldo Wallet JYYR tidak mencukupi.');
          return;
        }

        submitting=true;
        submit.disabled=true;
        submitLabel.textContent='Memproses pesanan…';
        errorBox.hidden=true;

        try{
          const result=await window.JYYRApi.request(
            '/api/dwigital/orders',
            {
              method:'POST',
              body:{
                type:form.dataset.type,
                productId:form.dataset.productId,
                variantId:selected.dataset.variantId,
                target:target.value.trim(),
                targetZone:zone.disabled?undefined:(zone.value.trim()||undefined),
                paymentMethod,
                idempotencyKey,
                returnUrl:window.location.origin+'/orders'
              }
            }
          );

          if(result?.payment?.paymentUrl){
            window.location.assign(result.payment.paymentUrl);
            return;
          }

          if(result?.order?.id){
            window.location.assign(
              '/orders/'+encodeURIComponent(result.order.id)
            );
            return;
          }

          throw new Error('Respons pesanan tidak lengkap. Periksa halaman Pesanan.');
        }catch(error){
          showError(error?.message||'Pembelian gagal diproses.');
          submitting=false;
          syncSubmit();
        }
      });
    })();
    </script>
  </div>

  <div class="product-detail-info-cta">
    <p>
      Temukan pilihan digital lainnya di
      <a class="product-detail-category-link" href="/store">Katalog Digital</a>.
    </p>
  </div>


    <section
      class="section product-detail-info"
      aria-labelledby="dwigital-product-info-title"
    >
      <header class="product-detail-info-header">
        <h2 id="dwigital-product-info-title">
          Keunggulan Berbelanja Produk Digital di Jyyr Store
        </h2>
        <p class="product-detail-info-lead">
          Pilih produk digital melalui katalog, periksa detail varian,
          lalu lakukan transaksi dari halaman yang sama.
        </p>
      </header>

      <h3>Harga Terjangkau dan Kompetitif</h3>
      <p>
        Harga setiap varian ditampilkan sebelum pembelian. Harga dan
        ketersediaan diverifikasi kembali oleh server sebelum pesanan dibuat.
      </p>

      <h3>Katalog Produk Digital</h3>
      <p>
        Katalog Dwigital menyediakan kategori aplikasi premium, editing,
        streaming dan musik, AI dan produktivitas, serta top up game
        sesuai produk yang aktif ditampilkan.
      </p>

      <h3>Proses Cepat dan Terstruktur</h3>
      <p>
        Pilih varian, lengkapi target dan zona apabila diminta,
        kemudian selesaikan pembayaran. Pesanan diproses berdasarkan
        status dan respons penyedia produk.
      </p>

      <h3>Aman dan Terverifikasi</h3>
      <p>
        Informasi varian, harga, dan ketersediaan diperiksa kembali
        oleh server sebelum transaksi dibuat.
      </p>

      <h3>Metode Pembayaran</h3>
      <ul>
        <li>Saldo Wallet JYYR, apabila saldo mencukupi.</li>
        <li>Gateway / QRIS melalui penyedia pembayaran.</li>
      </ul>

      <h3>Customer Support Responsif</h3>
      <p>
        Apabila mengalami kendala pada transaksi atau pemrosesan pesanan,
        gunakan kanal bantuan Jyyr Store dan sertakan informasi pesanan
        yang relevan.
      </p>

      <h3>Garansi</h3>
      <p>
        Ketentuan garansi mengikuti aturan produk dan penyedia masing-masing.
        Periksa informasi produk sebelum menyelesaikan pembelian.
      </p>

      <h3>Cara Memesan</h3>
      <ol class="product-detail-steps">
        <li>Pilih salah satu varian yang tersedia.</li>
        <li>Isi target dan zona apabila kolom tersebut ditampilkan.</li>
        <li>Periksa nominal pembayaran dan pilih metode pembayaran.</li>
        <li>Selesaikan pembayaran dan pantau status pesanan.</li>
      </ol>

      <div class="product-detail-info-cta">
        <p>
          Lihat kategori dan produk digital lainnya di
          <a class="product-detail-category-link" href="/store">Store</a>.
        </p>
      </div>
    </section>

    <section
      class="product-reviews-section"
      aria-labelledby="dwigital-product-reviews-title"
    >
      <div class="section-header product-reviews-header">
        <div>
          <h2 id="dwigital-product-reviews-title">Ulasan Pembeli</h2>
          <p>
            Modul ulasan Dwigital belum terhubung dengan sistem ulasan
            produk lokal. Rating dan review tidak ditampilkan sebelum
            tersedia data yang valid.
          </p>
        </div>
      </div>

      <div class="product-review-summary-grid product-review-summary-grid-single">
        <section
          class="product-review-chart panel"
          aria-label="Status ulasan Dwigital"
        >
          <div class="product-review-panel-title">
            <div>
              <div class="eyebrow">Ulasan Dwigital</div>
              <h3>Rating Pembelian</h3>
            </div>
            <span class="product-review-count">Belum tersedia</span>
          </div>

          <div class="product-review-summary-foot">
            <strong>Rating belum tersedia</strong>
            <span>
              Data ulasan Dwigital belum terintegrasi.
            </span>
          </div>
        </section>
      </div>
    </section>

    <% const dwigitalRecommendationSections = [
      {
        id:'dwigital-related-title',
        title:'Produk Terkait',
        products:relatedProducts,
        emptyTitle:'Belum ada produk terkait',
        emptyDescription:'Belum ada produk lain dalam kategori ini.'
      },
      {
        id:'dwigital-bestseller-title',
        title:'Produk Terlaris',
        products:bestSellerProducts,
        emptyTitle:'Belum ada produk terlaris',
        emptyDescription:'Belum ada data pembelian yang memenuhi kategori terlaris.'
      }
    ]; %>

    <% dwigitalRecommendationSections.forEach(collection=>{ %>
      <section
        class="section product-detail-recommendations"
        aria-labelledby="<%= collection.id %>"
      >
        <div class="section-header">
          <div>
            <h2 id="<%= collection.id %>"><%= collection.title %></h2>
            <p>
              <%= collection.title==='Produk Terlaris'
                ? 'Produk dengan jumlah pesanan berhasil tertinggi.'
                : 'Produk lain dalam kategori yang sama.' %>
            </p>
          </div>
        </div>

        <% if(collection.products.length){ %>
          <div class="product-grid">
            <% collection.products.forEach(product=>{ %>
              <a
                class="product-card provider-product-card"
                href="/store/dwigital/<%= product.provider_type %>/<%= encodeURIComponent(product.provider_product_id) %>"
                aria-label="Lihat detail <%= product.display_name %>"
              >
                <div class="product-thumb-wrap">
                  <% if(product.cover_url){ %>
                    <img
                      class="product-thumb"
                      src="<%= product.cover_url %>"
                      alt="Cover <%= product.display_name %>"
                      width="600"
                      height="600"
                      loading="lazy"
                      decoding="async"
                    >
                  <% } else { %>
                    <div class="image-fallback">
                      <%- icon('image') %>
                      <span>Gambar tidak tersedia</span>
                    </div>
                  <% } %>
                </div>

                <div class="product-body">
                  <div class="product-action-row">
                    <span class="product-title">
                      <%= product.display_name %>
                    </span>
                  </div>
                  <p class="muted small">
                    <%= product.category_name %>
                  </p>
                </div>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <%- include('../partials/empty',{
            title:collection.emptyTitle,
            description:collection.emptyDescription
          }) %>
        <% } %>
      </section>
    <% }) %>

</section>
